# ========================================================
# CALLIVO — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# “Meet. Connect. Collaborate.”
#
# INSTRUCTIONS:
# Copy this file to .env and configure values for your environment:
# cp .env.example .env
#
# IMPORTANT: NEVER commit your actual .env file to GitHub.
# ========================================================

# --- Application Server & Network ---
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-app-domain.com
SERVER_URL=https://your-api-domain.com

# --- Database Connection ---
# SQLite for local development:
DATABASE_URL="file:./dev.db"
# PostgreSQL for production (Render, Supabase, Neon, Railway, AWS RDS):
# DATABASE_URL="postgresql://username:password@host:5432/callivo?schema=public&sslmode=require"

# --- Redis Cache & Realtime PubSub (Optional, graceful fallback to in-memory) ---
# REDIS_URL="redis://localhost:6379"

# --- Authentication & Cryptographic Secrets ---
# Minimum 32-character random string (generate with: openssl rand -base64 32)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_characters"
JWT_REFRESH_SECRET="replace_with_a_secure_random_refresh_secret_min_32_characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Email Notifications & Password Resets (Resend API) ---
RESEND_API_KEY="re_sample_api_key_here"
EMAIL_FROM="CALLIVO Support <onboarding@resend.dev>"
SUPPORT_EMAIL="support@callivo.com"
SUPPORT_PHONE="+1 (555) 019-2834"

# --- WebRTC STUN & TURN Infrastructure ---
# STUN (Session Traversal Utilities for NAT):
STUN_SERVER_URL="stun:stun.l.google.com:19302"

# TURN (Traversal Using Relays around NAT) - Required for restrictive enterprise firewalls & symmetric NAT:
# Leave blank to use STUN-only mode, or configure with Coturn / Twilio / Metered credentials:
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_PASSWORD=""

# --- Frontend Environment Variables (Only if deploying Frontend separately on Vercel/Netlify) ---
# Leave empty for unified single-domain deployment:
# VITE_API_URL=https://your-backend-domain.com
# VITE_SERVER_URL=https://your-backend-domain.com
