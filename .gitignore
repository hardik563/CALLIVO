# ========================================================
# CALLIVO — GIT IGNORE CONFIGURATION
# ========================================================

# Dependencies
node_modules/
server/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development
.env.test
.env.production
.env.*
server/.env
server/.env.local
server/.env.development
server/.env.test
server/.env.production
server/.env.*
!.env.example
!server/.env.example

# Build Outputs & Bundles
dist/
server/dist/
build/
out/
.next/

# Databases & Local Data (Never commit dev database files)
*.db
*.db-journal
*.sqlite
*.sqlite3
server/prisma/*.db
server/prisma/*.db-journal

# User Uploads & Media Files (Preserve folder structure via .gitkeep)
uploads/*
!uploads/.gitkeep
!uploads/avatars/
uploads/avatars/*
!uploads/avatars/.gitkeep
!uploads/recordings/
uploads/recordings/*
!uploads/recordings/.gitkeep
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/avatars/
server/uploads/avatars/*
!server/uploads/avatars/.gitkeep

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test & Coverage
coverage/
.nyc_output/

# IDE & Editor Files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Scratch & Temporary Directories
scratch/
tmp/
temp/
.temp/
